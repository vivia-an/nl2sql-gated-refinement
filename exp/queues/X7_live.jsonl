# X7 live tests (internal note X7): value probing (A), confidence-routed adaptive path (B) on HR + HT-300 (tuning data only; never dev).
# Run on the host: python3 code/tools/queue_run.py loop --queue exp/queues/X7_live.jsonl --name X7 --interval 60   (after code/scripts/sync_pod.sh <worker machine> ships code/ + exp/)
# Every run command first imports the call-cache archive of EXACTLY ONE earlier X5 run into the machine-local cache (cache_export.py import, idempotent):
#   probe / empty control -> 1b-*-gated   (same M1 + generation calls as full_gated, so the roots are the gated roots and only the empty-result revisions are new calls)
#   adaptive              -> 2-*-cons     (M1 + generation + the n=4 sampling request are all cache hits)
# Do NOT import several runs at once: the same M1 request got different answers in different runs (API non-determinism at T=0); the first imported answer
# wins, and the sampling prompts of 2-*-cons then differ from the cached ones for ~1/3 of the questions (measured by tools/cache_dryrun.py).
# A fresh worker machine cache without the import re-runs everything: probe/empty ~2.0 calls/q (HT 606 + HR 2224 calls, ~CNY 13), adaptive 3.0 calls/q (HT 900 + HR 3303, ~CNY 23).
# Embedding requests of questions whose embeddings are not in the worker machine cache are real (tiny) API calls and are not counted in est_calls.
# conc 4 per job (the cap is per model: run the jobs one after the other if another queue is active). est_calls = NEW chat calls with the import.
{"command": "$PY tools/cache_export.py import $R/runs/X5/1b-ht-gated && $PY -m nl2sql.run --system full_gated --split bird_train_HT --model qwen37plus --seed 0 --config exp/configs/full_gated_probe.yaml --exp X7 --out $R/runs/X7/probe-ht --workers 8 --conc 4", "conc": 4, "est_calls": 30, "heavy": true, "id": "x7-probe-ht", "max_attempts": 2, "model": "qwen37plus", "needs_key": true, "out": "runs/X7/probe-ht", "priority": 10}
{"after": ["x7-probe-ht"], "command": "$PY tools/cache_export.py import $R/runs/X5/1b-hr-gated && $PY -m nl2sql.run --system full_gated --split bird_train_HR --model qwen37plus --seed 0 --config exp/configs/full_gated_probe.yaml --exp X7 --out $R/runs/X7/probe-hr --workers 8 --conc 4", "conc": 4, "est_calls": 150, "heavy": true, "id": "x7-probe-hr", "max_attempts": 2, "model": "qwen37plus", "needs_key": true, "out": "runs/X7/probe-hr", "priority": 9}
