# X9 live tests (internal note X9): value grounding (m2.value_grounding = the M2 business-metadata source) on HR + HT-300 (tuning data only; never dev).
# Run on the host: python3 code/tools/queue_run.py loop --queue exp/queues/X9_live.jsonl --name X9 --interval 60   (after code/scripts/sync_pod.sh <worker machine> ships code/ + exp/)
# Candidate = full_gated_vg.yaml (= full_gated.yaml + m2.value_grounding); reference = the stored X5 gated runs 1b-{hr,ht}-gated (same M1, same roots, same seed 0).
# Every run command first imports the call-cache archive of EXACTLY ONE earlier run (1b-*-gated; cache_export.py import is idempotent). M1 requests are then cache
# hits; a generation request is a hit iff the question gets NO value hint (the prompt is byte-identical to full_gated then), so only the questions WITH hints produce
# new chat calls. Do NOT import several runs at once (the same M1 request got different answers in different X5 runs; the first imported answer wins).
# The value index of each database is built at the start of the run (FullSystem.warm; read-only, <= 90 s per database, cached under the machine-local cache, limits in
# internal note X9). On a worker machine that has not read the big databases (bike_share_1 5 GB, donor 4.5 GB) the first build is slower; the HR job needs a worker machine with the data volume mounted.
# Estimated NEW chat calls: HT ~228 (225 questions with a hint, ~3 revisions), HR ~744 (729 + ~15) = ~975 calls, ~CNY 6.4 at list price (prompt tokens x 2.0 + completion x 8.0 CNY/M,
# implicit-cache discount ignored). Without the import (cold worker machine cache) a gated run costs ~2.0 calls/q: HT 606 + HR 2224 calls, ~CNY 13. Embedding requests of questions whose embeddings are not
# in the worker machine cache are real (tiny) API calls and are not counted in est_calls. conc 4 per job (the cap is per model: run other queues one after the other).
# Adoption rule (tools/x7_adopt.py, mechanical): ADOPT iff HT-300 paired dEX vs full_gated has a database-clustered percentile-bootstrap 95 % lower bound > 0 (B = 10000) AND on HR
# the point estimate is > 0 with no more negative than positive databases and at most one negative database. HT has 4 databases / 300 questions: a miss is not evidence of no effect;
# quote the HR sign line and the W/L counts as well.
# x9-cmp-pooled (HR + HT, 12 databases clustered) is supplementary and NOT part of the adoption rule: all HT answers a hint can reach sit in one database (world_development_indicators), so the HT-300 bound cannot be positive by construction.
{"command": "$PY tools/cache_export.py import $R/runs/X5/1b-ht-gated && $PY -m nl2sql.run --system full_gated --split bird_train_HT --model qwen37plus --seed 0 --config exp/configs/full_gated_vg.yaml --exp X9 --out $R/runs/X9/vg-ht --workers 8 --conc 4", "conc": 4, "est_calls": 228, "heavy": true, "id": "x9-vg-ht", "max_attempts": 2, "model": "qwen37plus", "needs_key": true, "out": "runs/X9/vg-ht", "priority": 10}
{"after": ["x9-vg-ht"], "command": "$PY tools/cache_export.py import $R/runs/X5/1b-hr-gated && $PY -m nl2sql.run --system full_gated --split bird_train_HR --model qwen37plus --seed 0 --config exp/configs/full_gated_vg.yaml --exp X9 --out $R/runs/X9/vg-hr --workers 8 --conc 4", "conc": 4, "est_calls": 744, "heavy": true, "id": "x9-vg-hr", "max_attempts": 2, "model": "qwen37plus", "needs_key": true, "out": "runs/X9/vg-hr", "priority": 9}
{"after": ["x9-vg-ht"], "command": "mkdir -p $R/runs/X9/cmp && $PY tools/paired_compare.py $R/runs/X5/1b-ht-gated/preds.jsonl $R/runs/X9/vg-ht/preds.jsonl --label-a full_gated --label-b gated_vg --boot 10000 --json $R/runs/X9/cmp/paired_ht.json", "conc": 0, "est_calls": 0, "heavy": false, "id": "x9-cmp-ht", "max_attempts": 2, "needs_key": false, "out": "runs/X9/cmp", "priority": 1}
{"after": ["x9-vg-hr"], "command": "mkdir -p $R/runs/X9/cmp && $PY tools/paired_compare.py $R/runs/X5/1b-hr-gated/preds.jsonl $R/runs/X9/vg-hr/preds.jsonl --label-a full_gated --label-b gated_vg --boot 10000 --json $R/runs/X9/cmp/paired_hr.json", "conc": 0, "est_calls": 0, "heavy": false, "id": "x9-cmp-hr", "max_attempts": 2, "needs_key": false, "out": "runs/X9/cmp", "priority": 1}
{"after": ["x9-vg-hr", "x9-vg-ht"], "command": "mkdir -p $R/runs/X9/cmp && cat $R/runs/X5/1b-hr-gated/preds.jsonl $R/runs/X5/1b-ht-gated/preds.jsonl > $R/runs/X9/cmp/ref_pool.jsonl && cat $R/runs/X9/vg-hr/preds.jsonl $R/runs/X9/vg-ht/preds.jsonl > $R/runs/X9/cmp/vg_pool.jsonl && $PY tools/paired_compare.py $R/runs/X9/cmp/ref_pool.jsonl $R/runs/X9/cmp/vg_pool.jsonl --label-a full_gated --label-b gated_vg --boot 10000 --json $R/runs/X9/cmp/paired_pooled.json", "conc": 0, "est_calls": 0, "heavy": false, "id": "x9-cmp-pooled", "max_attempts": 2, "needs_key": false, "out": "runs/X9/cmp", "priority": 1}
{"after": ["x9-vg-hr", "x9-vg-ht"], "command": "mkdir -p $R/runs/X9/cmp && $PY tools/x7_adopt.py --ref-hr $R/runs/X5/1b-hr-gated --ref-ht $R/runs/X5/1b-ht-gated --cand value_grounding=$R/runs/X9/vg-hr,$R/runs/X9/vg-ht --boot 10000 --out $R/runs/X9/cmp/x9_adoption.json", "conc": 0, "est_calls": 0, "heavy": false, "id": "x9-adopt", "max_attempts": 2, "needs_key": false, "out": "runs/X9/cmp", "priority": 0}
